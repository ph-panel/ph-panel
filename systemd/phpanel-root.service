[Unit]
Description=PH-PANEL privileged helper (services, hosting)
After=network.target

[Service]
Type=simple
ExecStart=/opt/phpanel/phpanel-root serve --socket /run/phpanel-root.sock --user phpanel --log /opt/phpanel/logs/root.log
Restart=on-failure
RestartSec=2

# The helper runs as root but is confined: it talks to systemd, writes service configuration and
# account directories, and runs a fixed set of commands [F1]. No W^X restriction: it starts rspamadm (LuaJIT).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc /home /var/lib /var/log /var/backups -/var/spool/postfix /opt/phpanel
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryMax=192M

[Install]
WantedBy=multi-user.target
