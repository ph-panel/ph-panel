[Unit]
Description=PH-PANEL web (UI + API on :8443)
After=network-online.target phpanel-root.service
Wants=network-online.target phpanel-root.service

[Service]
Type=simple
User=phpanel
Group=phpanel
EnvironmentFile=-/etc/phpanel/web.env
ExecStart=/opt/phpanel/phpanel-web serve --data /opt/phpanel/data --listen :8443 \
  --cert /opt/phpanel/ssl/panel/fullchain.pem --key /opt/phpanel/ssl/panel/privkey.pem \
  --auth-log /opt/phpanel/logs/auth.log
Restart=on-failure
RestartSec=3
# the phpMyAdmin sign-on socket lives in /run/phpanel; its group is the only way in besides the panel itself
RuntimeDirectory=phpanel
RuntimeDirectoryMode=0755
SupplementaryGroups=phpanel-pma

# isolation: the web process has no root privileges [F1]
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/opt/phpanel/data /opt/phpanel/logs /var/lib/phpanel/migrations
ReadOnlyPaths=/opt/phpanel/ssl
MemoryMax=128M

[Install]
WantedBy=multi-user.target
